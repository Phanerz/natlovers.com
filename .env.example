# Copy to .env.local and fill in. Every name below is one the code actually reads.

# Database (Supabase Postgres). The pooled URL runs the site; the direct URL runs migrations.
DB_POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/natlovers"
DB_POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/natlovers"

# Sign-in
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
# Comma separated. These emails can open /mimin.
ADMIN_EMAILS="you@example.com,teammate@example.com"

# Uploaded photos (Vercel Blob)
NATLOVERS_READ_WRITE_TOKEN="replace-with-vercel-blob-read-write-token"

# Emails (Resend)
RESEND_API_KEY="replace-with-resend-api-key"
RESEND_FROM_EMAIL="Natlovers <orders@example.com>"

# Bank transfer details shown at checkout for rupiah orders
BANK_TRANSFER_ACCOUNT_NAME="Natlovers"
BANK_TRANSFER_ACCOUNT_NUMBER="0000000000"
BANK_TRANSFER_BANK_NAME="Bank Central Asia"

# Rupiah payments through Xendit hosted invoices. Both must be set to turn it on; if either is
# missing, rupiah checkout uses manual bank transfer. Server only, never NEXT_PUBLIC.
# Test and live keys never mix: a test key (xnd_development_...) goes with the test callback token.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
